# AuraCare demo defaults: no external network calls.
AURACARE_MODE=mock
DATABASE_PROVIDER=memory
MESSAGING_PROVIDER=mock
VISION_PROVIDER=mock
VOICE_PROVIDER=mock
STORE_RAW_PROVIDER_PAYLOADS=false
MAX_WEBHOOK_UPLOAD_MB=5

# Live mode must be configured explicitly. Never commit real credentials.
# AURACARE_MODE=live
# DATABASE_PROVIDER=supabase
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# MESSAGING_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=
# VISION_PROVIDER=openai
# OPENAI_API_KEY=
# VOICE_PROVIDER=twilio

# Stage demonstration modes: fully_simulated, hybrid, live_integration, backup_simulation
AURACARE_DEMO_MODE=fully_simulated
AURACARE_OPERATOR_TOKEN=
AURACARE_REGION=UK
MEDIA_RETENTION_DAYS=7
